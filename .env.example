NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser. Used by device attendance endpoints (stage 2).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Minimum seconds between clock-in and clock-out (default 60). Use 0 while testing.
ATTENDANCE_MIN_STAY_SECONDS=

# Production only. Long random string; Vercel Cron sends it so nobody else can trigger the photo cleanup.
CRON_SECRET=

# Telegram bot (owner only). Set with `vercel env add`; never paste these into chat.
TELEGRAM_BOT_TOKEN=
# One or more Telegram IDs separated by commas, e.g. 123456789,987654321
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TICK_SECRET=
# Optional; defaults to https://papawash-hris.vercel.app. Used for links inside bot messages.
APP_URL=
